# ---------------------------------------------------------------------------
# Lezgo Suite — variables de entorno
# Copia este archivo a .env.local y rellena lo que vayas a usar.
# El panel arranca sin ninguna de ellas: sirve datos de ejemplo.
# ---------------------------------------------------------------------------

# Base de datos (Neon Postgres). Sin esta variable el panel usa src/data/demo.ts.
# Usa una rama propia de este proyecto para no tocar tus otros proyectos en Neon.
DATABASE_URL=

# GoHighLevel API v2 — token de agencia (Private Integration Token).
# Scopes mínimos: contacts.readonly, contacts.write, opportunities.readonly,
# opportunities.write, locations.readonly, conversations/message.write,
# workflows.readonly, calendars.readonly
GHL_API_KEY=

# Subcuenta por defecto cuando una herramienta no recibe una explícita.
GHL_LOCATION_ID=

# Vercel AI Gateway — da acceso al modelo del copiloto.
AI_GATEWAY_API_KEY=
